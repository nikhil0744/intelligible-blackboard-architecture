# ---- Student 2: LLM broker ----
LLM_BACKEND=ollama            # ollama | litellm | mock
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_MAX_CONCURRENCY=2         # parallel in-flight model calls (raise on a GPU box)
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_NUM_CTX=8192
