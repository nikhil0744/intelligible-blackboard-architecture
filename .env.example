# ---- Student 2: LLM broker ----
LLM_BACKEND=ollama            # ollama | litellm | mock
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_MAX_CONCURRENCY=1         # one loaded model, one request at a time (pilot default)
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_NUM_CTX=8192              # context window (tokens)
LLM_MAX_TOKENS=768            # maximum generated response
LLM_MAX_REPAIRS=2             # repair responses after an invalid first response
